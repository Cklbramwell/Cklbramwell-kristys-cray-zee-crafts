rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{userId}/{orderId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.admin == true
        )
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
